{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "resolveJsonModule": true, "isolatedModules": true, "useDefineForClassFields": true, "noUnusedLocals": false, "noUnusedParameters": false
  },
  "include": ["src", "scripts/dev"]
}
